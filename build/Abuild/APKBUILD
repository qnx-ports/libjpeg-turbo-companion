# AlpineContributor: Carlo Landmeter <clandmeter@alpinelinux.org>
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=libjpeg-turbo
pkgver=3.1.1
pkgrel=${pkgrel:-0}
pkgdesc="Accelerated baseline JPEG compression and decompression library"
url="https://libjpeg-turbo.org/"
arch="all"
license="BSD-3-Clause AND IJG AND Zlib"
makedepends="cmake nasm ninja"
replaces="libjpeg"
subpackages="
    $pkgname-static
    $pkgname-doc
    $pkgname-dev
    libturbojpeg
    $pkgname-utils
    "
source="https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/$pkgver/libjpeg-turbo-$pkgver.tar.gz
        allow-aarch64le-as-aarch64.patch"

build() {
    CFLAGS="$CFLAGS -O2 -DNDEBUG" \
    CXXFLAGS="$CXXFLAGS -O2 -DNDEBUG" \
    cmake -B build-shared -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=/usr/lib \
        -DBUILD_SHARED_LIBS=True \
        -DENABLE_STATIC=False \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DWITH_JPEG8=1
    cmake --build build-shared

    cmake -B build-static -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=/usr/lib \
        -DBUILD_SHARED_LIBS=False \
        -DENABLE_STATIC=True \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DWITH_JPEG8=1
    cmake --build build-static
}

check() {
    # random checksum failures
    ctest --test-dir build-shared 
 #       -E '(djpeg-shared-3x2-float-prog-cmp|example-12bit-shared-decompress-cmp)'
}

package() {
    DESTDIR="$pkgdir" cmake --install build-static
    DESTDIR="$pkgdir" cmake --install build-shared
    install -d "$pkgdir"/usr/share/licenses/$pkgname
    ln -s ../../doc/libjpeg-turbo/LICENSE.md "$pkgdir/usr/share/licenses/$pkgname"
}

utils() {
    pkgdesc="Utilities for manipulating JPEG images"
    replaces="jpeg"

    amove usr/bin
}

libturbojpeg() {
    amove usr/lib/libturbojpeg.so.*
}

doc() {
    default_doc
    replaces="jpeg-doc"
}

dev() {
    default_dev
    replaces="jpeg-dev"
}


options="$options ${DISABLE_CHECK:+!check}"
sha512sums="
d08c8eb77281c1eee2c93ef9f2eefaf79a4b9adff5172ebcb20c845ccad8896a28fc3d622002cc8b28964ff860dca0a491d6b1b921aaa7aedccd21b909aad4cb  libjpeg-turbo-3.1.1.tar.gz
8dd77f623441003ecd5455fde5c44beda3093bfe356bcf8e869f2f43d96e651771f0f87c3e43c2ca3ebdc725d458da9bc97faab45aa2be31e4c208b165639787  allow-aarch64le-as-aarch64.patch
"
